# Benchmark image: build TS and run benchmark script
# Build from repo root: docker build -f benchmark/docker/Dockerfile.typescript .

FROM node:22-alpine AS build
WORKDIR /src
COPY typescript/ typescript/
WORKDIR /src/typescript
RUN npm ci 2>/dev/null || npm install && npm run build

FROM node:22-alpine
WORKDIR /app
COPY --from=build /src/typescript/dist /app/dist
COPY --from=build /src/typescript/package.json /app/
COPY benchmark/runners/run_ts.mjs /app/run_ts.mjs
ENV GRAPH_FILE=/data/graph.txt
# run_ts.mjs requires ../../typescript/dist -> we copy dist to /app/dist so require('./dist') works
ENTRYPOINT ["node", "/app/run_ts.mjs"]
