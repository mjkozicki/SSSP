<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SSSP</RootNamespace>
    <AssemblyName>SSSP</AssemblyName>
    <Description>SSSP class library</Description>
    <Version>1.0.0</Version>
    <Authors>SSSP</Authors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Library only: exclude tests and benchmark so they are not compiled into the library -->
    <Compile Remove="SSSP.Tests/**" />
    <Compile Remove="SSSP.Benchmark/**" />
  </ItemGroup>

</Project>
